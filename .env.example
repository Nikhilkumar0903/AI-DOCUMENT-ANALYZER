# Text-summary provider: gemini (cloud free tier) or ollama (local)
SUMMARY_PROVIDER=gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=replace_with_your_api_key
# Set true only after reading the Gemini unpaid-service data-use notice.
GEMINI_UNPAID_API_ACKNOWLEDGED=false
GEMINI_API_TIMEOUT=60
GEMINI_CHUNK_CHARS=16000

# Local Ollama is still used for optional vision fallback and can be selected
# for text analysis by setting SUMMARY_PROVIDER=ollama.
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=llava-phi3
# Keep localhost for private use; set to 0.0.0.0 only for trusted LAN/cloud hosting.
HOST=127.0.0.1
PORT=8000
AUTH_REQUIRED=false
OCR_LANG=en
OCR_DEVICE=cpu
MAX_UPLOAD_MB=25
MAX_UPLOAD_FILES=10
MAX_UPLOAD_TOTAL_MB=100
MAX_ANALYSES_PER_USER_PER_DAY=3
JOB_RETENTION_DAYS=7
DOCUMIND_DATA_DIR=./data

# Public account sign-in. These values come from your Supabase project.
# The anon key is public; never put the service-role key in the frontend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only needed if your Supabase project uses legacy HS256 JWT signing.
SUPABASE_JWT_SECRET=
